<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.yanalice.voice"
    android:versionCode="19" android:versionName="2.9">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <application android:allowBackup="false" android:usesCleartextTraffic="false"
        android:icon="@drawable/assistant_icon" android:banner="@drawable/assistant_banner"
        android:label="Max Station Voice" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".VoiceActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:name=".LiveActivity" android:exported="true"
            android:screenOrientation="landscape" android:permission="android.permission.DUMP"/>
        <activity android:name=".AssistantOverlayActivity" android:exported="true"
            android:permission="android.permission.DUMP" android:theme="@style/AssistantOverlay"
            android:launchMode="singleTask" android:taskAffinity="org.yanalice.voice.overlay"
            android:excludeFromRecents="true"/>
        <activity-alias android:name=".AssistantHome" android:targetActivity=".LiveActivity"
            android:label="Max Station Voice" android:icon="@drawable/assistant_icon"
            android:banner="@drawable/assistant_banner" android:permission="" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity android:name=".AlarmActivity" android:exported="false" android:screenOrientation="landscape"/>
        <receiver android:name=".StationAlarm" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/></intent-filter>
        </receiver>
        <service android:name=".GroqRecognitionService" android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </service>
        <service android:name=".SpotifyPlaybackService" android:exported="true"
            android:label="Max Station — воспроизведение Spotify"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/spotify_playback_service"/>
        </service>
        <provider android:name=".SetupProvider" android:authorities="org.yanalice.voice.setup"
            android:exported="true" android:permission="android.permission.DUMP"/>
    </application>
</manifest>
