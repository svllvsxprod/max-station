<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.yanalice.settings.shortcuts"
    android:versionCode="3" android:versionName="3.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="Настройки колонки" android:allowBackup="false"
        android:icon="@mipmap/ic_settings"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">
        <activity android:name=".ShortcutActivity" android:exported="false"
            android:excludeFromRecents="true" android:noHistory="true" />
        <activity-alias android:name=".AndroidSettings" android:targetActivity=".ShortcutActivity"
            android:label="Настройки Android" android:icon="@mipmap/ic_settings"
            android:banner="@drawable/banner_settings" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".NetworkSettings" android:targetActivity=".ShortcutActivity"
            android:label="Сеть и Wi-Fi" android:icon="@mipmap/ic_network"
            android:banner="@drawable/banner_network" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".VpnSettings" android:targetActivity=".ShortcutActivity"
            android:label="VPN и интернет" android:icon="@mipmap/ic_vpn"
            android:banner="@drawable/banner_vpn" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".SmartTube" android:targetActivity=".ShortcutActivity"
            android:label="YouTube" android:icon="@mipmap/ic_smarttube"
            android:banner="@drawable/banner_smarttube" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
